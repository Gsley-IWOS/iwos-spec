{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gsley-IWOS/iwos-spec/schemas/constitution-lock/1.0.0",
  "title": "IWOS Constitutional Integrity Lock",
  "description": "Contract for .ai/CONSTITUTION_LOCK.yaml: SHA-256 digests of every protected document, generated by the validator.",
  "x-iwos-document": {
    "id": "SCH-008",
    "version": "1.0.0",
    "status": "Ratified",
    "authority": "standards/testing-standard.md",
    "parent_document": "governance/change-control-policy.md"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "algorithm", "generated_by", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "authority", "last_updated"],
      "properties": {
        "id": { "const": "MEM-008" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "const": "Active" },
        "authority": { "const": "governance/change-control-policy.md" },
        "last_updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "algorithm": { "const": "sha256" },
    "generated_by": { "const": "tools/validate/validate.py --write-lock" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(engineering-charter|standards|governance)/[A-Za-z0-9_.-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
