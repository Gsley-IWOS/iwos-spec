{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gsley-IWOS/iwos-spec/schemas/decision-graph/1.0.0",
  "title": "IWOS Repository Decision Graph",
  "description": "Contract for .ai/DECISION_GRAPH.yaml: decisions that constrain future work and are not Architecture Decision Records.",
  "x-iwos-document": {
    "id": "SCH-006",
    "version": "1.0.0",
    "status": "Ratified",
    "authority": "standards/testing-standard.md",
    "parent_document": "engineering-charter/05_AI_AGENT_CONTRACT.yaml"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "decisions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "authority", "last_updated"],
      "properties": {
        "id": { "type": "string", "pattern": "^MEM-[0-9]{3}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$" },
        "status": { "enum": ["Active", "Superseded"] },
        "authority": { "type": "string", "minLength": 1 },
        "last_updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "status", "title", "authority", "context", "decision", "consequences", "related_files", "related_records"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEC-[0-9]{4}$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] },
          "title": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "pattern": "^(\\.ai/|\\.github/)?[A-Za-z0-9_./-]+$" },
          "context": { "type": "string", "minLength": 20 },
          "decision": { "type": "string", "minLength": 20 },
          "consequences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "related_files": { "type": "array", "items": { "type": "string", "pattern": "^(\\.ai/|\\.github/)?[A-Za-z0-9_./-]+$" } },
          "related_records": { "type": "array", "items": { "type": "string", "pattern": "^(adr|aip|governance/rfc)/[A-Za-z0-9_./-]+\\.md$" } },
          "superseded_by": { "type": "string", "pattern": "^DEC-[0-9]{4}$" }
        }
      }
    }
  }
}
