{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gsley-IWOS/iwos-spec/schemas/knowledge-graph/1.0.0",
  "title": "IWOS Repository Knowledge Graph",
  "description": "Contract for .ai/KNOWLEDGE_GRAPH.yaml: documents and concepts as nodes, authority and dependency as edges.",
  "x-iwos-document": {
    "id": "SCH-005",
    "version": "1.0.0",
    "status": "Ratified",
    "authority": "standards/testing-standard.md",
    "parent_document": "engineering-charter/05_AI_AGENT_CONTRACT.yaml"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "authority", "last_updated"],
      "properties": {
        "id": { "type": "string", "pattern": "^MEM-[0-9]{3}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$" },
        "status": { "enum": ["Active", "Superseded"] },
        "authority": { "type": "string", "minLength": 1 },
        "last_updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": {
            "enum": ["system", "repository", "constitutional_document", "programme_document", "architecture_document",
                     "governance_document", "standard", "contract", "onboarding_document", "decision_record",
                     "proposal", "work_package", "schema", "template", "tooling", "memory", "concept"]
          },
          "label": { "type": "string", "minLength": 1 },
          "document_id": { "type": "string", "pattern": "^[A-Z]+(-[A-Z]+)*-([0-9]{3,4}|INDEX)(-[0-9]{3})?$" },
          "path": { "type": "string", "pattern": "^(\\.ai/|\\.github/)?[A-Za-z0-9_./-]+$", "not": { "pattern": "^/|\\.\\./" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relationship"],
        "properties": {
          "from": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "to": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "relationship": {
            "enum": ["specifies", "governs", "derives_from", "implements", "enforces", "indexes", "validates",
                     "authorises", "records", "binds", "depends_on", "summarises", "defines", "part_of", "proposes_change_to"]
          }
        }
      }
    }
  }
}
