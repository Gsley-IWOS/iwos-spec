{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gsley-IWOS/iwos-spec/schemas/ai-bootstrap/1.0.0",
  "title": "IWOS AI Bootstrap",
  "description": "Contract for AI_BOOTSTRAP.yaml, the machine-readable onboarding manifest for AI agents.",
  "x-iwos-document": {
    "id": "SCH-002",
    "version": "1.0.0",
    "status": "Ratified",
    "authority": "standards/testing-standard.md",
    "parent_document": "engineering-charter/05_AI_AGENT_CONTRACT.yaml"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document", "repository", "contract_mandatory_reading", "repository_onboarding_reading", "execution_sequence",
    "protected_documents", "engineering_memory", "validation", "handoff", "authority_chain",
    "prohibited_actions_source", "ratification"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document": { "$ref": "#/$defs/documentMetadata" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organisation", "name", "role", "implementation_repository", "default_branch",
                   "implementation_code_expected", "architecture_changes_allowed_without_governance"],
      "properties": {
        "organisation": { "type": "string", "minLength": 1 },
        "name": { "const": "iwos-spec" },
        "role": { "const": "constitutional-specification-repository" },
        "implementation_repository": { "type": "string", "minLength": 1 },
        "default_branch": { "type": "string", "minLength": 1 },
        "implementation_code_expected": { "const": false },
        "architecture_changes_allowed_without_governance": { "const": false }
      }
    },
    "contract_mandatory_reading": {
      "description": "Exactly the documents named by agent_requirements.mandatory_reading in the ratified AI Agent Contract.",
      "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/readingItem" }
    },
    "repository_onboarding_reading": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/readingItem" } },
    "recommended_reading": { "type": "array", "items": { "$ref": "#/$defs/readingItem" } },
    "execution_sequence": {
      "description": "Mirrors execution_sequence in the AI Agent Contract: thirteen steps.",
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "action", "evidence"],
        "properties": {
          "step": { "type": "integer", "minimum": 1, "maximum": 13 },
          "action": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "protected_documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_file", "change_authority", "path_patterns"],
      "properties": {
        "lock_file": { "const": ".ai/CONSTITUTION_LOCK.yaml" },
        "change_authority": { "type": "string", "minLength": 1 },
        "path_patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "engineering_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changelog", "current_state", "next_task", "engineering_state", "knowledge_graph", "decision_graph", "manifest"],
      "properties": {
        "changelog": { "$ref": "#/$defs/relativePath" },
        "current_state": { "$ref": "#/$defs/relativePath" },
        "next_task": { "$ref": "#/$defs/relativePath" },
        "engineering_state": { "$ref": "#/$defs/relativePath" },
        "knowledge_graph": { "$ref": "#/$defs/relativePath" },
        "decision_graph": { "$ref": "#/$defs/relativePath" },
        "manifest": { "$ref": "#/$defs/relativePath" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "requirements", "continuous_integration"],
      "properties": {
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "continuous_integration": { "$ref": "#/$defs/relativePath" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "mandatory_sections"],
      "properties": {
        "template": { "$ref": "#/$defs/relativePath" },
        "mandatory_sections": {
          "description": "The six sections of the AI Agent Contract plus Validation, added by Code Review Playbook Section 6.",
          "type": "array",
          "const": ["Summary", "Files Changed", "Decisions", "Validation", "Risks", "Outstanding Work", "Recommended Next Task"]
        }
      }
    },
    "authority_chain": { "type": "array", "minItems": 12, "items": { "type": "string", "minLength": 1 } },
    "prohibited_actions_source": { "const": "engineering-charter/05_AI_AGENT_CONTRACT.yaml" },
    "ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "effective_on", "amendment_authority"],
      "properties": {
        "status": { "enum": ["Ratified", "Proposed", "Draft"] },
        "effective_on": { "type": "string", "minLength": 1 },
        "amendment_authority": { "$ref": "#/$defs/relativePath" }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(\\.ai/|\\.github/)?[A-Za-z0-9_./-]+$",
      "not": { "pattern": "^/|\\.\\./" }
    },
    "readingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "documentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "version", "status", "authority", "parent_document", "last_updated"],
      "properties": {
        "id": { "type": "string", "pattern": "^AIO-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "status": { "enum": ["Ratified", "Proposed", "Draft", "Superseded"] },
        "authority": { "$ref": "#/$defs/relativePath" },
        "parent_document": { "$ref": "#/$defs/relativePath" },
        "last_updated": { "$ref": "#/$defs/isoDate" }
      }
    },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$" },
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
